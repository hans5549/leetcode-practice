{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet run *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet run *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& (Join-Path ($env:CLAUDE_PROJECT_DIR ?? '.') '.claude/hooks/guard-solution.ps1')",
            "statusMessage": "Checking Solution.cs guard..."
          }
        ]
      }
    ]
  }
}
